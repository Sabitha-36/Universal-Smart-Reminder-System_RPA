{
  "Metadata": {
    "Id": "5f21f9ab-0296-4f52-af4f-a3660cb165ea",
    "Kind": "FormIo"
  },
  "DesignProperties": {
    "Title": "NewForm",
    "Theme": "Default",
    "ShowInTaskbar": true,
    "ShowMargin": true,
    "CustomStyle": ""
  },
  "Data": {
    "components": [
      {
        "tag": "h2",
        "content": "Add Academic Task",
        "key": "label",
        "input": false,
        "tableView": false,
        "label": "Label",
        "type": "label"
      },
      {
        "label": "Task Name ",
        "labelPosition": "left-left",
        "tableView": true,
        "validate": {
          "required": true
        },
        "key": "taskName",
        "type": "textfield",
        "input": true
      },
      {
        "label": "Category ",
        "labelPosition": "left-left",
        "widget": "choicesjs",
        "tableView": true,
        "data": {
          "values": [
            {
              "label": "Assignment",
              "value": "assignment"
            },
            {
              "label": "Project",
              "value": "project"
            },
            {
              "label": "Exam",
              "value": "exam"
            },
            {
              "label": "Seminar",
              "value": "seminar"
            },
            {
              "label": "Events",
              "value": "events"
            },
            {
              "label": "Submission",
              "value": "submission"
            },
            {
              "label": "Presentation",
              "value": "presentation"
            },
            {
              "label": "Other",
              "value": "other"
            }
          ]
        },
        "validate": {
          "required": true
        },
        "key": "category",
        "type": "select",
        "input": true
      },
      {
        "label": "Subject",
        "labelPosition": "left-left",
        "tableView": true,
        "validate": {
          "required": true
        },
        "key": "subject",
        "type": "textfield",
        "input": true
      },
      {
        "label": "Deadline",
        "labelPosition": "left-left",
        "format": "dd/MM/yyyy",
        "tableView": false,
        "datePicker": {
          "disableWeekends": false,
          "disableWeekdays": false
        },
        "enableTime": false,
        "validate": {
          "required": true
        },
        "enableMinDateInput": false,
        "enableMaxDateInput": false,
        "key": "deadline",
        "type": "datetime",
        "input": true,
        "widget": {
          "type": "calendar",
          "displayInTimezone": "viewer",
          "locale": "en",
          "useLocaleSettings": false,
          "allowInput": true,
          "mode": "single",
          "enableTime": false,
          "noCalendar": false,
          "format": "dd/MM/yyyy",
          "hourIncrement": 1,
          "minuteIncrement": 1,
          "time_24hr": false,
          "minDate": null,
          "disableWeekends": false,
          "disableWeekdays": false,
          "maxDate": null
        }
      },
      {
        "label": "Priority",
        "labelPosition": "left-left",
        "widget": "choicesjs",
        "tableView": true,
        "data": {
          "values": [
            {
              "label": "High",
              "value": "high"
            },
            {
              "label": "Medium",
              "value": "medium"
            },
            {
              "label": "Low",
              "value": "low"
            }
          ]
        },
        "validate": {
          "required": true
        },
        "key": "priority",
        "type": "select",
        "input": true
      },
      {
        "label": "Status",
        "optionsLabelPosition": "right",
        "inline": false,
        "tableView": false,
        "values": [
          {
            "label": "Pending",
            "value": "pending",
            "shortcut": ""
          },
          {
            "label": "In Progress",
            "value": "inProgress",
            "shortcut": ""
          }
        ],
        "key": "status",
        "type": "radio",
        "input": true
      },
      {
        "label": "Description",
        "tableView": true,
        "key": "description",
        "type": "textarea",
        "input": true
      },
      {
        "label": "Add Task",
        "showValidations": false,
        "disableOnInvalid": true,
        "tableView": false,
        "key": "submit",
        "type": "button",
        "input": true,
        "saveOnEnter": false
      }
    ]
  }
}